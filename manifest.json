{
  "manifest_version": 3,
  "name": "CineKeep",
  "version": "1.0",
  "description": "Keep track of your favorite movies and TV shows in a vibrant, responsive dashboard.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}
